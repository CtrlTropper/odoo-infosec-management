<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. FORM VIEW: Giao diện chi tiết sự cố -->
    <record id="view_infosec_incident_form" model="ir.ui.view">
        <field name="name">infosec.incident.form</field>
        <field name="model">infosec.incident</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Thanh trạng thái mức độ nghiêm trọng -->
                    <field name="severity" widget="statusbar" statusbar_visible="low,medium,high,critical"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2>
                            <field name="title" placeholder="VD: Phát hiện lưu lượng SSH bất thường..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                        </group>
                        <group>
                            <field name="severity"/>
                        </group>
                    </group>
                    <!-- Sử dụng Notebook để chia tab cho giao diện gọn gàng -->
                    <notebook>
                        <page string="Mô tả chi tiết" name="description">
                            <field name="description" placeholder="Nhập chi tiết sự cố tại đây..."/>
                        </page>
                        <page string="Raw Security Log (Dành cho AI)" name="raw_log">
                            <!-- Widget mã nguồn để paste log hệ thống cho gọn -->
                            <field name="raw_log_data" placeholder="Paste raw log từ thiết bị (Syslog/JSON) vào đây để AI phân tích..." widget="code"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. LIST VIEW: Danh sách sự cố -->
    <record id="view_infosec_incident_list" model="ir.ui.view">
        <field name="name">infosec.incident.list</field>
        <field name="model">infosec.incident</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity in ('high', 'critical')" decoration-warning="severity == 'medium'">
                <field name="name"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="severity" widget="badge" 
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'high'"
                       decoration-info="severity == 'medium'"
                       decoration-success="severity == 'low'"/>
            </list>
        </field>
    </record>

    <!-- 3. KANBAN VIEW: Giao diện thẻ kéo thả -->
    <record id="view_infosec_incident_kanban" model="ir.ui.view">
        <field name="name">infosec.incident.kanban</field>
        <field name="model">infosec.incident</field>
        <field name="arch" type="xml">
            <kanban default_group_by="severity" class="o_kanban_small_column">
                <field name="name"/>
                <field name="title"/>
                <field name="asset_id"/>
                <field name="severity"/>
                <templates>
                    <!-- FIX BUG: Đổi 'kanban-box' thành 'card' -->
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/> - <field name="title"/>
                                </strong>
                                <div class="mt-2">
                                    Thiết bị: <strong><field name="asset_id"/></strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!-- 4. ACTION -->
    <record id="action_infosec_incident" model="ir.actions.act_window">
        <field name="name">Sự cố Bảo mật</field>
        <field name="res_model">infosec.incident</field>
        <!-- Khai báo hiển thị Kanban đầu tiên, sau đó đến List và Form -->
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- 5. MENU -->
    <menuitem id="menu_infosec_incident" name="Quản lý Sự cố" parent="menu_infosec_root" action="action_infosec_incident" sequence="20"/>
</odoo>